# 需要支持 eth_getLogs 的 BSC 主网 RPC；不要使用测试网。
BSC_RPC_URL=https://rpc-bsc.48.club
# 不填写钱包私钥或cookie；服务只通过本机已登录的baw操作。
# 默认使用 npm ci 安装的项目内 baw 1.11.0；覆盖时使用可信绝对路径。
# BAW_BIN=/absolute/path/to/baw
# 初次仅监控和预览。也可以在页面通过钱包检查后开启，重启恢复本项设置。
ENABLE_LIVE_TRADING=false
# 正常端口4318，npm run demo默认4319；如设PORT会覆盖两者。
# PORT=4318
